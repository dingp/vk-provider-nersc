{
  "apiVersion": "batch/v1",
  "kind": "Job",
  "metadata": {
    "namespace": "nersc-vk-tests",
    "labels": {
      "app.kubernetes.io/part-of": "vk-nersc-cpu-examples"
    },
    "annotations": {
      "nersc.sf/credentialSecretName": "sfapi-client",
      "nersc.slurm/nodes": "1",
      "nersc.slurm/cpus-per-task": "1",
      "nersc.slurm/mem": "1GB",
      "nersc.slurm/time": "00:05:00",
      "nersc.slurm/constraint": "cpu",
      "nersc.slurm/account": "REPLACE_WITH_ACCOUNT",
      "nersc.slurm/qos": "REPLACE_WITH_QOS"
    },
    "name": "vk-example-job"
  },
  "spec": {
    "backoffLimit": 0,
    "parallelism": 1,
    "completions": 1,
    "template": {
      "metadata": {
        "namespace": "nersc-vk-tests",
        "labels": {
          "app.kubernetes.io/part-of": "vk-nersc-cpu-examples"
        },
        "annotations": {
          "nersc.sf/credentialSecretName": "sfapi-client",
          "nersc.slurm/nodes": "1",
          "nersc.slurm/cpus-per-task": "1",
          "nersc.slurm/mem": "1GB",
          "nersc.slurm/time": "00:05:00",
          "nersc.slurm/constraint": "cpu",
          "nersc.slurm/account": "REPLACE_WITH_ACCOUNT",
          "nersc.slurm/qos": "REPLACE_WITH_QOS"
        }
      },
      "spec": {
        "automountServiceAccountToken": false,
        "restartPolicy": "Never",
        "nodeSelector": {
          "kubernetes.io/hostname": "perlmutter-vk"
        },
        "tolerations": [
          {
            "key": "virtual-kubelet.io/provider",
            "operator": "Equal",
            "value": "nersc",
            "effect": "NoSchedule"
          }
        ],
        "containers": [
          {
            "name": "smoke",
            "command": [
              "sh",
              "-ec"
            ],
            "resources": {
              "requests": {
                "cpu": "1",
                "memory": "1Gi"
              },
              "limits": {
                "cpu": "1",
                "memory": "1Gi"
              }
            },
            "image": "docker.io/library/debian@sha256:f3034a6ec3c1205360777c4aae76234998866ad18806ae62b63a3f84ccad782b",
            "args": [
              "echo VK_TEST_vk-example-job; date -u; hostname; test \"$((19+23))\" -eq 42; sleep 15; echo CPU_CHECK_PASSED"
            ]
          }
        ]
      }
    }
  }
}
