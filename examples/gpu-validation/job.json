{
  "apiVersion": "batch/v1",
  "kind": "Job",
  "metadata": {
    "namespace": "nersc-vk-tests",
    "labels": {
      "app": "vk-gpu-validation"
    },
    "annotations": {
      "nersc.sf/credentialSecretName": "sfapi-client",
      "nersc.slurm/nodes": "1",
      "nersc.slurm/cpus-per-task": "2",
      "nersc.slurm/mem": "4G",
      "nersc.slurm/time": "00:05:00",
      "nersc.slurm/constraint": "gpu",
      "nersc.slurm/account": "REPLACE_WITH_ACCOUNT",
      "nersc.slurm/qos": "REPLACE_WITH_QOS",
      "nersc.slurm/gpus-per-node": "4",
      "nersc.slurm/gpus-per-task": "4",
      "nersc.slurm/ntasks": "1",
      "nersc.slurm/launcher": "srun"
    },
    "name": "vk-gpu-smoke"
  },
  "spec": {
    "backoffLimit": 0,
    "parallelism": 1,
    "completions": 1,
    "template": {
      "metadata": {
        "namespace": "nersc-vk-tests",
        "labels": {
          "app": "vk-gpu-validation"
        },
        "annotations": {
          "nersc.sf/credentialSecretName": "sfapi-client",
          "nersc.slurm/nodes": "1",
          "nersc.slurm/cpus-per-task": "2",
          "nersc.slurm/mem": "4G",
          "nersc.slurm/time": "00:05:00",
          "nersc.slurm/constraint": "gpu",
          "nersc.slurm/account": "REPLACE_WITH_ACCOUNT",
          "nersc.slurm/qos": "REPLACE_WITH_QOS",
          "nersc.slurm/gpus-per-node": "4",
          "nersc.slurm/gpus-per-task": "4",
          "nersc.slurm/ntasks": "1",
          "nersc.slurm/launcher": "srun"
        }
      },
      "spec": {
        "automountServiceAccountToken": false,
        "restartPolicy": "Never",
        "nodeSelector": {
          "kubernetes.io/hostname": "perlmutter-vk"
        },
        "tolerations": [
          {
            "key": "virtual-kubelet.io/provider",
            "operator": "Equal",
            "value": "nersc",
            "effect": "NoSchedule"
          }
        ],
        "containers": [
          {
            "name": "cuda-smoke",
            "command": [
              "python3",
              "-u",
              "-c"
            ],
            "resources": {
              "requests": {
                "cpu": "2",
                "memory": "4Gi"
              }
            },
            "image": "docker.io/library/python@sha256:1aaa65a85fda306ffb8b910824d4e93bdce61e212c7e87168123ea3073b41a1a",
            "args": [
              "RENDER_WITH_RENDER_PY"
            ]
          }
        ]
      }
    }
  }
}
